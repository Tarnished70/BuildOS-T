git clone --depth=1 https://github.com/wHo-EM-i/android_hardware_qcom_camera hardware/qcom-caf/sdm660/camera -b sdm660-10.2.1.r1

git clone https://github.com/LineageOS/android_hardware_xiaomi hardware/xiaomi -b lineage-19.1
