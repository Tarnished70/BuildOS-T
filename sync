# extra stuff
#git clone --depth=1 --single-branch https://gitlab.com/Project-Nexus/nexus-clang.git /tmp/rom/prebuilts/clang/host/linux-x86/custom-clang -b nexus-14

# soc hals
rm -rf /tmp/rom/hardware/qcom-caf/sdm660/display
